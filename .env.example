# Database (Neon / Vercel Postgres)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Generated by `pnpm new-client`; otherwise: openssl rand -hex 32
PAYLOAD_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# DigitalOcean Spaces (S3 compatibile)
S3_ENDPOINT=https://fra1.digitaloceanspaces.com
S3_REGION=fra1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public bucket: portfolio photos
S3_PUBLIC_BUCKET=
# Public bucket URL (CDN or bucket endpoint), no trailing slash
S3_PUBLIC_URL=https://BUCKET.fra1.cdn.digitaloceanspaces.com
# Private bucket: password gallery photos (served through signed URLs)
S3_PRIVATE_BUCKET=

# Upstash Redis (REST) for the attempt limits on login and gallery passwords.
# Free plan is enough. Leave empty in local development (limits are skipped).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local MinIO needs path-style (Spaces: leave false)
S3_FORCE_PATH_STYLE=false

# --- Local development with `docker compose up -d` ---
# DATABASE_URL=postgres://photographers:photographers@localhost:5433/photographers
# S3_ENDPOINT=http://localhost:9100
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_PUBLIC_BUCKET=photos-public
# S3_PRIVATE_BUCKET=photos-private
# S3_PUBLIC_URL=http://localhost:9100/photos-public
# S3_FORCE_PATH_STYLE=true
